{
  "name": "ClipJod Video Editor",
  "short_name": "ClipJod",
  "description": "Free video editor: join clips, trim, text, music, transitions, keyframes and captions. No watermark.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
